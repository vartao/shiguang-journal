# 复制为 .env 后替换全部 CHANGE_ME 值
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_mysql_password
JWT_SECRET=CHANGE_ME_random_secret_at_least_32_characters
CORS_ORIGINS=https://CHANGE_ME.example.com

# 上传资源签名密钥（可选；不配置时复用 JWT_SECRET）
# FILE_SIGN_KEY=CHANGE_ME_random_sign_key_at_least_32_characters

# 阿里云 OSS（可选；不配置则上传文件保存在本地 upload_data 卷）
# ALIYUN_OSS_ENDPOINT=oss-cn-wuhan-lr.aliyuncs.com
# ALIYUN_OSS_BUCKET=your-bucket
# ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret
# ALIYUN_OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-wuhan-lr.aliyuncs.com
# ALIYUN_OSS_KEY_PREFIX=qinglv/

{
  "name": "shiguang-journal-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "lint": "eslint src vite.config.js --max-warnings=0",
    "lint:fix": "eslint src vite.config.js --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"*.{js,json}\"",
    "check": "npm run lint && npm run format:check && npm test -- --run"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}

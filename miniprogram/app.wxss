/* ========================================
   拾光手账小程序 - 全局样式（复古手账风）
   ======================================== */

page {
  /* 主色调 - 牛皮纸与旧照片 */
  --kraft: #d4a574;
  --kraft-light: #e8c9a0;
  --kraft-dark: #b8875a;
  --brown-deep: #5c3d2e;
  --brown: #7a5540;
  --cream: #faf3e0;
  --cream-warm: #f5ead3;
  --cream-dark: #efe2c8;
  --red: #c1666b;
  --red-dark: #a34f54;
  --olive: #7d8c5c;
  --mustard: #c9a227;
  --blue: #7a9bb5;

  /* 文字 */
  --ink: #3d2b1f;
  --text-2: #6b5344;
  --muted: #7d6a56;

  /* 圆角/阴影/描边 */
  --radius-s: 8rpx;
  --radius-m: 16rpx;
  --radius-l: 24rpx;
  --shadow-card: 0 4rpx 20rpx rgba(92, 61, 46, 0.15);
  --shadow-lift: 0 12rpx 36rpx rgba(60, 35, 15, 0.25);
  --line: rgba(92, 61, 46, 0.2);
  --line-soft: rgba(92, 61, 46, 0.1);

  /* 尺寸节奏 */
  --page-x: 32rpx;
  --btn-h: 80rpx;
  --tabbar-h: calc(104rpx + env(safe-area-inset-bottom));

  background: var(--cream);
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', 'Noto Serif SC', serif;
  font-size: 28rpx;
  line-height: 1.7;
}

view, text, button, input, textarea, scroll-view, image {
  box-sizing: border-box;
}

/* ============ 布局工具 ============ */
.page-wrap {
  padding: 32rpx var(--page-x) calc(var(--tabbar-h) + 40rpx);
  min-height: 100vh;
}

.page-wrap--no-tab {
  padding-bottom: 60rpx;
}

/* ============ 字体风格 ============ */
.hand-title {
  font-family: 'Ma Shan Zheng', 'STXingkai', 'KaiTi', '楷体', cursive;
  font-size: 52rpx;
  color: var(--brown-deep);
  letter-spacing: 4rpx;
}

.display {
  font-family: 'ZCOOL XiaoWei', 'STKaiti', 'KaiTi', '楷体', 'Noto Serif SC', serif;
}

.kicker {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: var(--muted);
  text-transform: uppercase;
}

/* 页头 */
.mast {
  text-align: center;
  padding: 32rpx 0 36rpx;
}

.mast__title {
  font-family: 'Ma Shan Zheng', 'STXingkai', 'KaiTi', '楷体', cursive;
  font-size: 52rpx;
  color: var(--brown-deep);
  letter-spacing: 4rpx;
}

.mast__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
  letter-spacing: 2rpx;
}

/* 栏目标题 */
.sec-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 40rpx 0 24rpx;
  font-family: 'ZCOOL XiaoWei', 'STKaiti', 'KaiTi', serif;
  font-size: 30rpx;
  color: var(--brown-deep);
  letter-spacing: 2rpx;
}

.sec-title::before,
.sec-title::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--line), transparent);
}

/* ============ 卡片 ============ */
.card {
  background: linear-gradient(170deg, #fdf8ec, #f5ead3);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-m);
  box-shadow: var(--shadow-card);
}

.card--glass {
  background: rgba(250, 243, 224, 0.72);
}

/* ============ 按钮 ============ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: var(--btn-h);
  padding: 0 40rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  border-radius: var(--radius-s);
  border: none;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-solid {
  color: var(--cream);
  background: linear-gradient(145deg, var(--brown), var(--brown-deep));
  box-shadow: 0 3rpx 10rpx rgba(60, 35, 15, 0.25);
}

.btn-red {
  color: var(--cream);
  background: linear-gradient(145deg, var(--red), var(--red-dark));
  box-shadow: 0 3rpx 10rpx rgba(193, 102, 107, 0.3);
}

.btn-ghost {
  color: var(--brown-deep);
  background: transparent;
  border: 2rpx solid var(--line);
}

.btn-sm {
  height: 60rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
}

.btn-busy,
.btn[disabled] {
  opacity: 0.55;
}

/* 按压反馈 */
.pressable {
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.pressed {
  transform: scale(0.97);
  opacity: 0.8;
}

/* ============ 标签 / chip ============ */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-2);
  background: rgba(212, 165, 116, 0.12);
  border: 2rpx solid rgba(92, 61, 46, 0.15);
  border-radius: 999rpx;
}

.chip--on {
  color: var(--cream);
  background: var(--brown-deep);
  border-color: var(--brown-deep);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: var(--brown);
  background: rgba(212, 165, 116, 0.18);
  border: 1rpx solid rgba(212, 165, 116, 0.45);
  border-radius: 999rpx;
}

/* ============ 表单 ============ */
.field {
  margin-bottom: 28rpx;
}

.field__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
  letter-spacing: 2rpx;
}

.input,
.textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: rgba(250, 243, 224, 0.8);
  border: 2rpx solid rgba(92, 61, 46, 0.25);
  border-radius: var(--radius-s);
}

.textarea {
  min-height: 160rpx;
}

.input--err {
  border-color: var(--red);
}

.placeholder {
  color: var(--muted);
  font-style: italic;
}

/* ============ 空态 / 骨架 / 加载 ============ */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty__icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty__title {
  font-family: 'Ma Shan Zheng', 'KaiTi', cursive;
  font-size: 36rpx;
  color: var(--text-2);
  margin-bottom: 10rpx;
}

.empty__desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 32rpx;
}

.sk {
  position: relative;
  overflow: hidden;
  background: rgba(92, 61, 46, 0.07);
  border-radius: var(--radius-s);
}

.sk::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  animation: sk-shimmer 1.5s infinite;
}

@keyframes sk-shimmer {
  to {
    transform: translateX(100%);
  }
}

.loading-text {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 4rpx;
}

/* ============ 底部弹层 ============ */
.mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  background: rgba(44, 30, 22, 0.48);
  animation: mask-in 0.24s ease both;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  max-height: 85vh;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--cream);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -12rpx 38rpx rgba(44, 30, 22, 0.18);
  animation: sheet-up 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
  overflow-y: auto;
}

.sheet::before {
  content: '';
  display: block;
  width: 64rpx;
  height: 6rpx;
  margin: 0 auto 20rpx;
  background: rgba(92, 61, 46, 0.2);
  border-radius: 999rpx;
}

.sheet__title {
  text-align: center;
  font-family: 'Ma Shan Zheng', 'KaiTi', cursive;
  font-size: 36rpx;
  color: var(--brown-deep);
  margin-bottom: 28rpx;
}

@keyframes mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes sheet-up {
  from {
    transform: translateY(60rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* ============ 入场动效 ============ */
.rise {
  animation: rise-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.d1 { animation-delay: 0.05s; }
.d2 { animation-delay: 0.12s; }
.d3 { animation-delay: 0.2s; }
.d4 { animation-delay: 0.28s; }
.d5 { animation-delay: 0.36s; }

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 小屏降级 */
@media (max-width: 360px) {
  .mast__title {
    font-size: 44rpx;
  }
}

/* 写笔记页 */

.write-sk {
  height: 900rpx;
  border-radius: var(--radius-m);
}

.write-form {
  padding: 32rpx 28rpx 40rpx;
}

.write-date {
  color: var(--ink);
}

/* 心情 / 天气选择 */
.pick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pick {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 108rpx;
  padding: 14rpx 0 10rpx;
  background: rgba(212, 165, 116, 0.1);
  border: 2rpx solid rgba(92, 61, 46, 0.15);
  border-radius: var(--radius-s);
}

.pick--on {
  background: rgba(193, 102, 107, 0.12);
  border-color: var(--red);
}

.pick__emoji {
  font-size: 36rpx;
  line-height: 1.2;
}

.pick__label {
  font-size: 20rpx;
  color: var(--text-2);
}

/* 图片九宫格 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-grid__cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.img-grid__img {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-s);
  border: 1rpx solid var(--line-soft);
}

.img-grid__del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--cream);
  background: var(--red);
  border-radius: 50%;
}

.img-grid__add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-s);
  color: var(--muted);
}

.img-grid__plus {
  font-size: 48rpx;
  line-height: 1;
}

.img-grid__hint {
  font-size: 22rpx;
}

.write-submit {
  width: 100%;
  margin-top: 12rpx;
}

/* 今天吃什么页 */
.chips-row {
  display: flex;
  gap: 16rpx;
  white-space: nowrap;
}

.chips-row .chip {
  flex-shrink: 0;
}

/* 随机选菜 hero */
.hero {
  padding: 28rpx;
}

.hero__chips-wrap {
  margin-bottom: 28rpx;
}

.hero__stage {
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.hero__name {
  font-family: 'Ma Shan Zheng', 'STXingkai', 'KaiTi', cursive;
  font-size: 56rpx;
  color: var(--brown-deep);
  letter-spacing: 4rpx;
  text-align: center;
}

.hero__name--roll {
  color: var(--muted);
}

.hero__note {
  font-size: 24rpx;
  color: var(--muted);
}

.hero__hint {
  font-size: 26rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.hero__meals {
  display: flex;
  gap: 16rpx;
}

.hero__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.hero__btn {
  width: 100%;
  border-radius: 999rpx;
}

/* 今日菜单 */
.menu-card {
  padding: 28rpx;
}

.menu-card__date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.menu-card__day {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brown-deep);
  letter-spacing: 2rpx;
}

.nav-arrow {
  padding: 8rpx 24rpx;
  font-size: 28rpx;
  color: var(--brown);
}

.nav-arrow--off {
  color: var(--line);
}

.meal {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--line-soft);
}

.meal:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.meal__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meal__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brown-deep);
}

.meal__add {
  font-size: 24rpx;
  color: var(--red);
  padding: 4rpx 12rpx;
}

.meal__items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.meal-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: var(--ink);
  background: rgba(212, 165, 116, 0.15);
  border: 1rpx solid rgba(212, 165, 116, 0.4);
  border-radius: 999rpx;
}

.meal-item__del {
  color: var(--red);
  font-size: 28rpx;
  line-height: 1;
}

.meal__empty {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* 菜品池 */
.pool {
  padding: 28rpx;
}

.pgroup {
  margin-bottom: 24rpx;
}

.pgroup__head {
  font-size: 24rpx;
  color: var(--text-2);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.dish {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--line-soft);
}

.dish:last-child {
  border-bottom: none;
}

.dish__info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.dish__name {
  font-size: 28rpx;
  color: var(--ink);
}

.dish__note {
  font-size: 22rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish__del {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--red);
  padding: 4rpx 12rpx;
}

.pool__add {
  width: 100%;
  margin-top: 8rpx;
}

.empty--small {
  padding: 48rpx 40rpx;
}

/* 加一道弹层 */
.pick-title {
  margin-top: 28rpx;
}

.pick-list {
  max-height: 480rpx;
}

.pick-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx dashed var(--line-soft);
}

.pick-item__name {
  font-size: 28rpx;
  color: var(--ink);
}

.pick-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

.sheet-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

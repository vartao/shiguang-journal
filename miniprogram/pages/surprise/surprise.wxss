.surprise-page{background-image:linear-gradient(rgba(92,61,46,.035) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(92,61,46,.035) 1rpx,transparent 1rpx);background-size:36rpx 36rpx}
.surprise-hero{position:relative;display:flex;align-items:center;gap:26rpx;overflow:hidden;padding:34rpx 30rpx;border-radius:28rpx;background:linear-gradient(135deg,var(--cream-dark),var(--kraft-light));border:1rpx solid var(--line);box-shadow:var(--shadow-card)}
.surprise-hero__box{position:relative;width:190rpx;height:170rpx;flex-shrink:0;background:linear-gradient(145deg,var(--red),var(--red-dark));border-radius:12rpx 12rpx 20rpx 20rpx;box-shadow:0 16rpx 24rpx rgba(92,61,46,.22);transform:rotate(-4deg)}
.surprise-hero__lid{position:absolute;left:-12rpx;right:-12rpx;top:-22rpx;height:54rpx;background:linear-gradient(145deg,var(--red-dark),var(--red));border-radius:10rpx;box-shadow:0 8rpx 12rpx rgba(92,61,46,.2)}
.surprise-hero__ribbon{position:absolute;top:-22rpx;bottom:0;left:76rpx;width:38rpx;background:var(--mustard)}.surprise-hero__heart{position:absolute;top:58rpx;left:62rpx;width:66rpx;height:66rpx;display:flex;align-items:center;justify-content:center;color:var(--red-dark);font-size:36rpx;background:var(--cream);border-radius:50%;box-shadow:0 4rpx 10rpx rgba(92,61,46,.18)}
.surprise-hero__copy{position:relative;z-index:2;flex:1}.surprise-hero__title{font-family:'Ma Shan Zheng','KaiTi',cursive;font-size:38rpx;color:var(--brown-deep)}.surprise-hero__desc{margin-top:8rpx;font-size:22rpx;color:var(--text-2);line-height:1.6}.surprise-hero__btn{margin:20rpx 0 0;width:100%}.surprise-hero__spark{position:absolute;color:var(--mustard);font-size:38rpx}.surprise-hero__spark--a{top:16rpx;right:28rpx}.surprise-hero__spark--b{bottom:18rpx;left:16rpx}
.surprise-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.surprise-sk{height:390rpx}.gift{position:relative;overflow:hidden;min-width:0}.gift__visual{position:relative;height:210rpx;overflow:hidden;background:linear-gradient(145deg,var(--cream-dark),var(--kraft-light))}.gift__cover{width:100%;height:100%}.gift__paper{position:absolute;left:24rpx;right:24rpx;top:34rpx;height:138rpx;background:var(--cream);border:1rpx solid var(--line);box-shadow:0 8rpx 20rpx rgba(92,61,46,.18);transform:rotate(-2deg)}.gift__fold{position:absolute;inset:0;clip-path:polygon(0 0,100% 0,50% 64%);background:var(--cream-dark);border-bottom:1rpx solid var(--line)}.gift__seal{position:absolute;left:50%;top:68rpx;transform:translateX(-50%);width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;color:var(--cream);font-size:24rpx;background:var(--red);border-radius:50%;box-shadow:0 3rpx 8rpx rgba(92,61,46,.22)}.gift__status{position:absolute;right:12rpx;bottom:12rpx;padding:5rpx 14rpx;color:var(--cream);font-size:19rpx;background:rgba(92,61,46,.84);border-radius:999rpx}.gift__status--open{background:var(--olive)}.gift__body{position:relative;padding:22rpx}.gift__title{font-size:28rpx;color:var(--brown-deep);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.gift__hint{margin-top:8rpx;height:70rpx;font-size:21rpx;color:var(--text-2);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.gift__meta{display:flex;flex-direction:column;gap:4rpx;margin-top:14rpx;font-size:19rpx;color:var(--muted)}.gift__delete{position:absolute;right:14rpx;bottom:12rpx;padding:6rpx 8rpx;color:var(--red-dark);font-size:19rpx}.gift--open{border-color:rgba(125,140,92,.45)}
.condition-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.condition{padding:18rpx 10rpx;text-align:center;background:rgba(212,165,116,.08);border:2rpx solid var(--line);border-radius:var(--radius-s)}.condition--on{border-color:var(--red);background:rgba(193,102,107,.1)}.condition__icon{font-size:34rpx}.condition__label{margin-top:6rpx;font-size:22rpx;color:var(--brown-deep);font-weight:600}.condition__desc{margin-top:3rpx;font-size:17rpx;color:var(--muted);line-height:1.4}.picker-box{min-height:76rpx}.cover-preview{position:relative;width:220rpx;height:150rpx}.cover-preview__img{width:100%;height:100%;border-radius:var(--radius-s)}.cover-preview__remove{position:absolute;top:-14rpx;right:-14rpx;width:42rpx;height:42rpx;display:flex;align-items:center;justify-content:center;color:var(--cream);background:var(--red-dark);border-radius:50%}.cover-add{display:flex;align-items:center;justify-content:center;height:110rpx;color:var(--brown);font-size:24rpx;background:rgba(212,165,116,.08);border:2rpx dashed var(--line);border-radius:var(--radius-s)}.surprise-content{min-height:190rpx}.submit-btn{width:100%}
.detail-sheet{position:fixed;inset:0;z-index:902;display:flex;align-items:center;justify-content:center;padding:70rpx 34rpx calc(70rpx + env(safe-area-inset-bottom));overflow-y:auto}.detail-card{position:relative;width:100%;max-height:88vh;padding:34rpx;background:linear-gradient(170deg,var(--cream),var(--cream-warm));border:1rpx solid var(--line);border-radius:24rpx;box-shadow:0 24rpx 80rpx rgba(44,30,22,.35);overflow-y:auto}.detail-card::before{content:'';position:absolute;inset:14rpx;border:1rpx dashed rgba(92,61,46,.18);border-radius:16rpx;pointer-events:none}.detail-cover{position:relative;z-index:1;height:260rpx;margin:-10rpx -10rpx 28rpx;overflow:hidden;border-radius:14rpx}.detail-cover__img{width:100%;height:100%}.detail-envelope{position:relative;width:260rpx;height:160rpx;margin:0 auto 26rpx;background:var(--kraft-light);border:1rpx solid var(--line);box-shadow:0 12rpx 24rpx rgba(92,61,46,.18)}.detail-envelope__flap{position:absolute;inset:0;clip-path:polygon(0 0,100% 0,50% 70%);background:var(--cream-dark);border-bottom:1rpx solid var(--line)}.detail-envelope__seal{position:absolute;left:50%;top:78rpx;transform:translateX(-50%);width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;color:var(--cream);background:var(--red);border-radius:50%}.detail-kicker{position:relative;text-align:center;font-size:18rpx;letter-spacing:5rpx;color:var(--muted)}.detail-title{position:relative;margin-top:8rpx;text-align:center;font-family:'Ma Shan Zheng','KaiTi',cursive;font-size:46rpx;color:var(--brown-deep)}.detail-from{position:relative;text-align:center;font-size:21rpx;color:var(--muted)}.locked-hint{position:relative;margin:26rpx 0;padding:24rpx;text-align:center;font-size:25rpx;color:var(--text-2);background:rgba(212,165,116,.1);border-left:6rpx solid var(--kraft)}.locked-rule{position:relative;display:flex;align-items:center;gap:18rpx;margin:20rpx 0;padding:20rpx;border:1rpx dashed var(--line);border-radius:var(--radius-s)}.locked-rule__icon{font-size:42rpx}.locked-rule__title{font-size:26rpx;color:var(--brown-deep);font-weight:600}.locked-rule__desc{font-size:21rpx;color:var(--muted)}.unlock-input{position:relative;margin-top:20rpx}.unlock-btn,.detail-delete,.detail-close{position:relative;width:100%;margin-top:20rpx}.detail-letter{position:relative;margin-top:30rpx;padding:34rpx 28rpx;min-height:180rpx;white-space:pre-wrap;font-family:'KaiTi','STKaiti',serif;font-size:29rpx;line-height:2;color:var(--ink);background:rgba(255,255,255,.36);border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line)}.detail-foot{position:relative;margin-top:20rpx;text-align:center;font-size:21rpx;color:var(--muted)}
.gift--busy{opacity:.62;pointer-events:none}

/* 小事记 */
.chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 14rpx;
  border-radius: var(--radius-l);
  background: var(--cream-warm);
  border: 2rpx solid var(--line-soft);
  color: var(--text-2);
  font-size: 26rpx;
  transition: all 0.2s ease;
}

.chip--on {
  background: var(--brown-deep);
  border-color: var(--brown-deep);
  color: var(--cream);
  font-weight: 600;
}

.yearbar {
  margin-bottom: 20rpx;
}

.yearpick {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-m);
  background: var(--cream-warm);
  border: 2rpx solid var(--line-soft);
  font-size: 26rpx;
  color: var(--text-2);
}

.log-sk {
  height: 180rpx;
  margin-bottom: 20rpx;
}

.log {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.log__cover {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: var(--radius-m);
  background: var(--cream-dark);
}

.log__body {
  flex: 1;
  min-width: 0;
}

.log__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.log__tag {
  font-size: 22rpx;
  color: var(--brown);
  background: rgba(212, 165, 116, 0.18);
  border-radius: var(--radius-s);
  padding: 4rpx 14rpx;
}

.log__date {
  font-size: 22rpx;
  color: var(--muted);
}

.log__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
}

.log__stars {
  margin-top: 6rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.star {
  color: rgba(212, 165, 116, 0.45);
}

.star--on {
  color: var(--mustard);
}

.log__note {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.log__ops {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  gap: 10rpx;
}

.log__op {
  font-size: 22rpx;
  color: var(--muted);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-s);
  background: var(--cream-warm);
  border: 2rpx solid var(--line-soft);
}

.log__op--del {
  color: var(--red-dark);
}

/* 表单弹层 */
.catgrid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.catgrid .chip {
  margin-right: 0;
}

.rating {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.star--pick {
  font-size: 44rpx;
}

.rating__hint {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

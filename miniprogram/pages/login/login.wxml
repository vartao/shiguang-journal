<view class="page-wrap page-wrap--no-tab login-page">
  <view class="mast rise">
    <view class="mast__title">拾光手账</view>
    <view class="mast__sub">把日子过成胶片里的诗</view>
  </view>

  <view class="card login-card rise d1">
    <view class="login-tabs">
      <view class="login-tab {{mode === 'login' ? 'login-tab--on' : ''}}" data-mode="login" bindtap="switchMode">登录</view>
      <view class="login-tab {{mode === 'register' ? 'login-tab--on' : ''}}" data-mode="register" bindtap="switchMode">注册</view>
    </view>

    <view class="field">
      <text class="field__label">用户名</text>
      <input class="input" placeholder-class="placeholder" placeholder="请输入用户名" maxlength="20" value="{{form.username}}" data-field="username" bindinput="onInput" />
    </view>

    <block wx:if="{{mode === 'register'}}">
      <view class="field">
        <text class="field__label">昵称</text>
        <input class="input" placeholder-class="placeholder" placeholder="给自己取个可爱的名字" maxlength="20" value="{{form.nickname}}" data-field="nickname" bindinput="onInput" />
      </view>

      <view class="field">
        <text class="field__label">我是（选填）</text>
        <view class="role-row">
          <view class="chip {{form.role === 'boy' ? 'chip--on' : ''}}" data-role="boy" bindtap="selectRole">👦 男生</view>
          <view class="chip {{form.role === 'girl' ? 'chip--on' : ''}}" data-role="girl" bindtap="selectRole">👧 女生</view>
        </view>
      </view>
    </block>

    <view class="field">
      <text class="field__label">密码</text>
      <input class="input" password placeholder-class="placeholder" placeholder="{{mode === 'register' ? '6-32 位密码' : '请输入密码'}}" maxlength="32" value="{{form.password}}" data-field="password" bindinput="onInput" />
    </view>

    <block wx:if="{{mode === 'register'}}">
      <view class="field">
        <text class="field__label">邀请码（选填）</text>
        <input class="input" placeholder-class="placeholder" placeholder="有 TA 的邀请码？填这里绑定" maxlength="12" value="{{form.inviteCode}}" data-field="inviteCode" bindinput="onInput" />
        <view class="login-hint">填了加入对方的小窝；不填会自动创建属于你自己的小窝</view>
      </view>

      <view class="field" wx:if="{{!form.inviteCode}}">
        <text class="field__label">在一起的日子（选填）</text>
        <picker mode="date" value="{{form.togetherDate}}" end="{{today}}" bindchange="onDateChange">
          <view class="input date-pick {{form.togetherDate ? '' : 'date-pick--empty'}}">{{form.togetherDate || '选择你们在一起的日期'}}</view>
        </picker>
      </view>
    </block>

    <button class="btn btn-solid login-submit {{loading ? 'btn-busy' : ''}}" disabled="{{loading}}" bindtap="submit">
      {{loading ? '请稍候…' : (mode === 'login' ? '进入手账' : (form.inviteCode ? '加入 TA 的小窝' : '创建并进入'))}}
    </button>
  </view>

  <view class="login-footer rise d2">
    <text>{{mode === 'login' ? '还没有账号？' : '已有账号？'}}</text>
    <text class="login-switch" data-mode="{{mode === 'login' ? 'register' : 'login'}}" bindtap="switchMode">{{mode === 'login' ? '去注册' : '去登录'}}</text>
  </view>
</view>

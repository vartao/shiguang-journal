/* 登录页 - 复古信纸感 */
.login-page {
  background:
    radial-gradient(ellipse 90% 50% at 15% 0%, rgba(212, 165, 116, 0.28), transparent 60%),
    radial-gradient(ellipse 80% 50% at 90% 90%, rgba(193, 102, 107, 0.14), transparent 55%),
    linear-gradient(165deg, var(--cream) 0%, var(--cream-warm) 55%, var(--cream-dark) 100%);
}

/* 信纸卡片：横线 + 左侧装订红线 */
.login-card {
  position: relative;
  padding: 36rpx 40rpx 40rpx 56rpx;
  overflow: hidden;
}

.login-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    transparent,
    transparent 47rpx,
    rgba(92, 61, 46, 0.04) 47rpx,
    rgba(92, 61, 46, 0.04) 48rpx
  );
  pointer-events: none;
}

.login-card::after {
  content: '';
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 28rpx;
  width: 2rpx;
  background: rgba(193, 102, 107, 0.35);
  pointer-events: none;
}

.login-card > * {
  position: relative;
  z-index: 1;
}

/* tab 切换 */
.login-tabs {
  display: flex;
  margin-bottom: 32rpx;
  border-bottom: 2rpx solid var(--line-soft);
}

.login-tab {
  flex: 1;
  padding: 16rpx 0 18rpx;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: var(--muted);
}

.login-tab--on {
  color: var(--brown-deep);
  font-weight: 600;
  box-shadow: inset 0 -4rpx 0 var(--red);
  border-radius: 2rpx;
}

/* 性别选择 */
.role-row {
  display: flex;
  gap: 20rpx;
}

.login-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--muted);
}

/* 日期选择 */
.date-pick--empty {
  color: var(--muted);
  font-style: italic;
}

.login-submit {
  width: 100%;
  margin-top: 12rpx;
}

/* 底部切换 */
.login-footer {
  margin-top: 36rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

.login-switch {
  margin-left: 10rpx;
  color: var(--red);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

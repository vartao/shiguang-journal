.anniversary-page{background-image:radial-gradient(rgba(92,61,46,.055) 1rpx,transparent 1rpx);background-size:22rpx 22rpx}
.hero{position:relative;overflow:hidden;min-height:360rpx;padding:42rpx 36rpx 36rpx;text-align:center;border-radius:28rpx;background:linear-gradient(145deg,var(--brown-deep),var(--brown));color:var(--cream)}
.hero::after{content:'';position:absolute;width:260rpx;height:260rpx;right:-110rpx;bottom:-120rpx;border:2rpx solid rgba(250,243,224,.18);border-radius:50%;box-shadow:0 0 0 30rpx rgba(250,243,224,.04),0 0 0 60rpx rgba(250,243,224,.03)}
.hero__stamp{position:absolute;top:26rpx;right:28rpx;padding:6rpx 14rpx;color:rgba(250,243,224,.6);border:2rpx solid rgba(250,243,224,.3);font-size:18rpx;letter-spacing:4rpx;transform:rotate(7deg)}
.hero__eyebrow{font-size:20rpx;letter-spacing:6rpx;color:rgba(250,243,224,.68)}
.hero__icon{margin-top:10rpx;font-size:64rpx}.hero__icon--empty{opacity:.72}
.hero__title{margin-top:4rpx;font-family:'Ma Shan Zheng','KaiTi',cursive;font-size:42rpx;letter-spacing:3rpx}
.hero__count{display:flex;align-items:baseline;justify-content:center;gap:12rpx;margin-top:8rpx}.hero__num{font-size:76rpx;font-weight:700;line-height:1.1}
.hero__unit,.hero__date{font-size:22rpx;color:rgba(250,243,224,.76)}.hero__date{margin-top:10rpx}
.toolbar{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:40rpx 0 24rpx}.toolbar__title{font-family:'ZCOOL XiaoWei','KaiTi',serif;font-size:32rpx;color:var(--brown-deep)}.toolbar__sub{margin-top:2rpx;font-size:22rpx;color:var(--muted)}
.anniversary-sk{height:210rpx;margin-bottom:24rpx}.anniv{position:relative;display:flex;align-items:stretch;min-height:210rpx;margin-bottom:24rpx;overflow:hidden}.anniv--today{border-color:rgba(193,102,107,.55);box-shadow:0 8rpx 30rpx rgba(193,102,107,.2)}
.anniv__date-tab{width:128rpx;flex-shrink:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;background:rgba(212,165,116,.16);border-right:1rpx dashed var(--line)}.anniv__icon{font-size:50rpx}.anniv__date{font-size:20rpx;color:var(--muted);writing-mode:vertical-rl;letter-spacing:2rpx}
.anniv__body{flex:1;min-width:0;padding:26rpx 20rpx 22rpx 24rpx}.anniv__head{display:flex;align-items:center;gap:12rpx}.anniv__title{min-width:0;flex:1;font-size:30rpx;color:var(--brown-deep);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.anniv__remark{margin-top:8rpx;font-size:23rpx;color:var(--text-2);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.anniv__meta{margin-top:10rpx;font-size:21rpx;color:var(--muted)}.anniv__ops{display:flex;gap:28rpx;margin-top:14rpx}.anniv__op{font-size:22rpx;color:var(--brown)}.anniv__op--delete{color:var(--red-dark)}
.anniv__count{width:126rpx;flex-shrink:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--brown-deep);border-left:1rpx dashed var(--line)}.anniv__count--soon,.anniv__count--today{color:var(--red-dark)}.anniv__count--past{color:var(--muted)}.anniv__num{max-width:116rpx;font-size:44rpx;font-weight:700;line-height:1.2;text-align:center}.anniv__unit{margin-top:4rpx;font-size:20rpx}
.repeat-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.repeat-card{padding:20rpx;background:rgba(212,165,116,.08);border:2rpx solid var(--line);border-radius:var(--radius-s)}.repeat-card--on{border-color:var(--brown-deep);background:rgba(212,165,116,.22)}.repeat-card__title{font-size:25rpx;color:var(--brown-deep);font-weight:600}.repeat-card__desc{margin-top:5rpx;font-size:19rpx;color:var(--muted);line-height:1.5}
.icon-row{display:flex;flex-wrap:wrap;gap:14rpx}.icon-choice{width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;background:rgba(212,165,116,.1);border:2rpx solid transparent;border-radius:50%}.icon-choice--on{border-color:var(--red);background:rgba(193,102,107,.12);transform:rotate(-6deg) scale(1.08)}
.picker-box{min-height:76rpx}.remark-input{min-height:120rpx}.submit-btn{width:100%}
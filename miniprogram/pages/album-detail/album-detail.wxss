/* 相册详情 */
.head {
  position: relative;
  text-align: center;
  padding: 16rpx 0 32rpx;
}

.head__back {
  position: absolute;
  left: 0;
  top: 24rpx;
  font-size: 26rpx;
  color: var(--brown);
  padding: 8rpx 16rpx 8rpx 0;
}

.head__title {
  font-family: 'Ma Shan Zheng', 'KaiTi', cursive;
  font-size: 48rpx;
  color: var(--brown-deep);
  letter-spacing: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.head__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.head__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.head__ops {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.head__del {
  color: var(--red-dark);
  border-color: rgba(193, 102, 107, 0.4);
}

/* 上传条 */
.upload-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
}

.upload-bar__title {
  font-size: 26rpx;
  color: var(--brown-deep);
}

.upload-bar__hint {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

/* 照片网格（3 列方图） */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo {
  width: 100%;
  height: 226rpx;
  border-radius: var(--radius-s);
  border: 6rpx solid #fdfaf3;
  box-shadow: var(--shadow-card);
  background: linear-gradient(150deg, var(--kraft-light), var(--cream-dark));
}

.photo-sk {
  height: 226rpx;
}

.tip {
  padding: 24rpx 0;
  text-align: center;
  font-size: 20rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.submit-btn {
  width: 100%;
  margin-top: 8rpx;
}

/* 行程详情页 */

.head-card {
  overflow: hidden;
}

.head-card__cover {
  width: 100%;
  height: 300rpx;
  display: block;
}

.head-card__body {
  padding: 28rpx;
}

.head-card__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.head-card__title {
  font-family: 'Ma Shan Zheng', 'STXingkai', 'KaiTi', cursive;
  font-size: 40rpx;
  color: var(--brown-deep);
  letter-spacing: 2rpx;
}

.st {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  color: var(--cream);
}

.st--olive { background: var(--olive); }
.st--mustard { background: var(--mustard); }
.st--blue { background: var(--blue); }

.head-card__meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.status-tip {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--muted);
  font-style: italic;
}

.head-card__note {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink);
  background: rgba(250, 243, 224, 0.8);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--radius-s);
  white-space: pre-wrap;
}

.head-card__ops {
  margin-top: 20rpx;
  display: flex;
  gap: 20rpx;
}

.head-card__ops .btn {
  flex: 1;
}

/* 每日安排 */
.empty--sm {
  padding: 48rpx 40rpx;
}

.day-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.day-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.day-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brown-deep);
  letter-spacing: 1rpx;
}

.day-card__del {
  font-size: 22rpx;
  color: var(--red-dark);
  padding: 6rpx 10rpx;
}

.day-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx dashed var(--line-soft);
}

.day-item__dot {
  color: var(--kraft-dark);
  font-weight: 700;
}

.day-item__text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
}

.day-item__del {
  font-size: 22rpx;
  color: var(--muted);
  padding: 4rpx 10rpx;
}

.day-add {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  align-items: center;
}

.day-add__input {
  flex: 1;
  padding: 14rpx 20rpx;
}

.day-add__btn {
  flex-shrink: 0;
}

.add-day {
  width: 100%;
  margin-bottom: 24rpx;
}

.save-btn {
  width: 100%;
}

/* 表单 */
.field-row {
  display: flex;
  gap: 20rpx;
}

.field--half {
  flex: 1;
}

.picker-view {
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

.cover-pick {
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-s);
  overflow: hidden;
  border: 2rpx dashed rgba(92, 61, 46, 0.25);
}

.cover-pick__img {
  width: 100%;
  height: 100%;
}

.cover-pick__ph {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 26rpx;
}

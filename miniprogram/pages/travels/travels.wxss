/* 足迹地图页 */

.map-card {
  padding: 16rpx;
}

.map-canvas {
  width: 100%;
  height: 560rpx;
}

.map-legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 8rpx 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  border: 1rpx solid var(--line);
}

.dot--visited { background: rgba(125, 140, 92, 0.6); }
.dot--planned { background: rgba(201, 162, 39, 0.5); }
.dot--default { background: rgba(212, 165, 116, 0.15); }

.legend-tip {
  margin-left: auto;
  font-style: italic;
}

/* 筛选栏 */
.filter-bar {
  margin-top: 28rpx;
}

.chips {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.province-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: var(--brown-deep);
  background: rgba(212, 165, 116, 0.18);
  border: 1rpx solid rgba(212, 165, 116, 0.45);
  border-radius: var(--radius-s);
}

.province-filter__clear {
  color: var(--red-dark);
  padding: 4rpx 8rpx;
}

/* 分组标题 */
.year-title {
  margin: 40rpx 0 16rpx;
  font-family: 'Ma Shan Zheng', 'STXingkai', 'KaiTi', cursive;
  font-size: 44rpx;
  color: var(--brown-deep);
  letter-spacing: 6rpx;
}

.season-row {
  margin: 20rpx 0 16rpx;
}

/* 足迹卡片 */
.travel-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.travel-card__cover {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: var(--radius-s);
  background: linear-gradient(150deg, var(--kraft-light), var(--kraft));
}

.travel-card__cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.travel-card__body {
  flex: 1;
  min-width: 0;
}

.travel-card__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.travel-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag--plan {
  color: #8a6d00;
  background: rgba(201, 162, 39, 0.18);
  border-color: rgba(201, 162, 39, 0.45);
  flex-shrink: 0;
}

.travel-card__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.travel-card__note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 新建按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(var(--tabbar-h) + 40rpx);
  z-index: 100;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: var(--cream);
  background: linear-gradient(145deg, var(--brown), var(--brown-deep));
  border-radius: 50%;
  box-shadow: var(--shadow-lift);
}

/* 表单 */
.picker-view {
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

.cover-pick {
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-s);
  overflow: hidden;
  border: 2rpx dashed rgba(92, 61, 46, 0.25);
}

.cover-pick__img {
  width: 100%;
  height: 100%;
}

.cover-pick__ph {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* 详情 */
.detail-cover {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-s);
  margin-bottom: 20rpx;
}

.detail-meta {
  font-size: 24rpx;
  color: var(--text-2);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.detail-tag {
  margin-left: 12rpx;
}

.detail-note {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink);
  background: rgba(250, 243, 224, 0.8);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--radius-s);
  white-space: pre-wrap;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-grid__img {
  width: 100%;
  height: 200rpx;
  border-radius: var(--radius-s);
}

.photo-grid__add {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--muted);
  border: 2rpx dashed rgba(92, 61, 46, 0.25);
  border-radius: var(--radius-s);
}

.photo-tip {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--muted);
  text-align: center;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.detail-actions .btn {
  flex: 1;
}

/* 骨架 */
.sk-card {
  height: 200rpx;
  margin-top: 24rpx;
  border-radius: var(--radius-m);
}

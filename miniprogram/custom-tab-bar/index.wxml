<view class="tabbar" style="padding-bottom: env(safe-area-inset-bottom);">
  <view
    wx:for="{{ tabs }}"
    wx:key="path"
    class="tab {{ selected === index ? 'on' : '' }}"
    hover-class="pressed"
    hover-stay-time="60"
    data-index="{{ index }}"
    bindtap="onTap"
  >
    <text class="tab__ico">{{ item.icon }}</text>
    <text class="tab__label">{{ item.label }}</text>
    <view wx:if="{{ selected === index }}" class="tab__dot"></view>
  </view>

  <!-- 中心写笔记按钮 -->
  <view class="tab tab--write" hover-class="pressed" hover-stay-time="60" bindtap="onWrite">
    <view class="write-btn">
      <text class="write-btn__ico">✏️</text>
    </view>
    <text class="tab__label">写笔记</text>
  </view>

  <view
    wx:for="{{ tabsRight }}"
    wx:key="path"
    class="tab {{ selected === item.tabIndex ? 'on' : '' }}"
    hover-class="pressed"
    hover-stay-time="60"
    data-index="{{ item.tabIndex }}"
    bindtap="onTap"
  >
    <text class="tab__ico">{{ item.icon }}</text>
    <text class="tab__label">{{ item.label }}</text>
    <view wx:if="{{ selected === item.tabIndex }}" class="tab__dot"></view>
  </view>
</view>
